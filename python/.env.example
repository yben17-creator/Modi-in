# Copy this file to .env and fill in. Never commit .env.
# SEC requires a descriptive User-Agent with a contact e-mail (https://www.sec.gov/os/accessing-edgar-data)
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional — Finnhub (free key at finnhub.io): price quotes, earnings calendar, consensus, EPS surprises, news
FINNHUB_API_KEY=

# Optional — Tiingo (free key at tiingo.com): adjusted daily price history, preferred source
TIINGO_API_KEY=

# Optional — Massive / formerly Polygon.io (massive.com): daily price history for backtests and momentum
MASSIVE_API_KEY=

# Optional — Yahoo Finance via the unofficial yfinance library (pip install yfinance). Off by default.
ENABLE_YFINANCE=false

# Optional — alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
